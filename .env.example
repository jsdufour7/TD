# ---------------------------------------------------------------------------
# TwoDots AI Core — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Runtime mode ------------------------------------------------------------
# development = dev seeding + heuristic planner allowed
# production  = no seeding, stricter defaults
APP_ENV=development

# --- Persistence -------------------------------------------------------------
# pglite   = embedded real PostgreSQL 18 engine (WASM). Zero external deps.
# postgres = a real PostgreSQL server via node-postgres.
DATABASE_DRIVER=pglite
# Where the embedded database files live (pglite only)
PGLITE_DATA_DIR=./.data/pglite
# Required when DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/ai_core

# --- Secrets -----------------------------------------------------------------
# Used to encrypt credential_references at rest and to sign session cookies.
# REQUIRED. Generate with: openssl rand -hex 32
AI_CORE_MASTER_KEY=

# --- Bootstrap administrator (first-run only) --------------------------------
AI_CORE_BOOTSTRAP_EMAIL=admin@twodots.local
AI_CORE_BOOTSTRAP_PASSWORD=changeme-please
AI_CORE_BOOTSTRAP_NAME=TwoDots Operator

# --- Storage -----------------------------------------------------------------
# local | s3 | r2   (s3/r2 adapters are stubbed; see IMPLEMENTATION_STATUS.md)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage

# --- Sandbox -----------------------------------------------------------------
# Every project gets a directory under this root. All file and command tools are
# confined to it. This is V1 sandboxing, NOT container isolation.
AI_CORE_SANDBOX_ROOT=./.data/sandbox

# --- Model providers (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint, including local llama.cpp / vLLM / Ollama.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL_API_KEY=
# LOCAL_MODEL_NAME=local-model

# --- Run engine --------------------------------------------------------------
# Max concurrent agent runs in the in-process worker
RUN_ENGINE_CONCURRENCY=2
# Kill switch: when false the worker will not claim new runs
RUN_ENGINE_ENABLED=true

# --- GitHub (optional) -------------------------------------------------------
# GITHUB_TOKEN=
